<?xml version="1.0" encoding="utf-8"?>
<!--
  The service pushes a new count on every reel. updatePeriodMillis (30 min, Android's minimum)
  is only the fallback that rolls the widget over to 0 after midnight when nothing is watched.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_reels"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="80dp"
    android:minResizeHeight="80dp"
    android:previewImage="@drawable/brain_stage_4"
    android:previewLayout="@layout/widget_reels"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:updatePeriodMillis="1800000"
    android:widgetCategory="home_screen" />
